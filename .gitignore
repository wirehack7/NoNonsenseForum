# ignore files that aren't part of NoNonsenseForum:
# (in this folder we want to ignore the site's data -- RSS feeds, subforums and configuration)
*
!.gitignore
!.gitattributes

# server
!.htaccess
!robots.txt
!favicon.default.ico
!apple-touch-icon.default.png
!metro-tile.default.png

# code
!config.default.php
!index.php
!start.php
!thread.php
!markup.php
!privacy.php
!search.php
!lib/
!themes/
!users/

# documentation
!HISTORY.txt
!INSTALL.txt
!LICENCE.txt
!README.txt

# dev tooling / CI (not part of the running forum itself)
!.github/
!.github/**
!composer.json
!composer.lock
!phpunit.xml
!phpstan.neon
!phpstan-bootstrap.php
!tests/
!tests/**
!Dockerfile
!.dockerignore